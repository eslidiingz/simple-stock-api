model Order {
  id                  String             @id @default(uuid())
  code                String             @unique @db.VarChar(50)
  company_id          String
  customer_id         String?
  product_count       Int
  product_count_items Int
  sub_total           Decimal
  discount            Decimal
  shipping            Decimal
  grand_total         Decimal
  receiver_name       String
  receiver_phone      String
  shipping_address    String
  note                String?
  tracking_code       String?
  shipping_provider   String?
  shipped_at          DateTime?
  delivered_at        DateTime?
  payment_method_id   String?
  payment_code        String
  payment_status      OrderPaymentStatus @default(UNPAID)
  status              OrderStatus        @default(PENDING)
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt
  deleted_at          DateTime?

  details        OrderDetail[]  @relation("OrderDetails")
  payment_method PaymentMethod? @relation(fields: [payment_method_id], references: [id])
  company        Company        @relation(fields: [company_id], references: [id])

  @@map("orders")
}

enum OrderPaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum OrderStatus {
  PENDING
  PROCESSING
  PACKED
  DELIVERY
  DELIVERED
  CANCEL
  RETURNED
  COMPLETED
}

model OrderDetail {
  id          String    @id @default(uuid())
  order_id    String
  product_id  String
  category_id String
  code        String
  name        String
  description String?
  price       Decimal
  quantity    Int
  total       Decimal
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  order   Order    @relation(fields: [order_id], references: [id], name: "OrderDetails")
  product Product? @relation(fields: [product_id], references: [id])

  @@map("order_details")
}
