model Product {
  id          String    @id @default(uuid())
  category_id String
  company_id  String
  code        String    @unique
  name        String
  description String?
  image       String?
  thumbnail   String?
  price       Decimal
  stock       Int       @default(0)
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  category        ProductCategory @relation(fields: [category_id], references: [id])
  stock_movements StockMovement[]
  OrderDetail     OrderDetail[]

  @@index([id])
  @@map("products")
}

model ProductCategory {
  id         String    @id @default(uuid())
  name       String
  created_by String? // ใครสร้าง (user_id)
  is_shared  Boolean   @default(false) // true = super admin สร้าง
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  products  Product[]
  companies CompanyCategory[]

  @@index([id])
  @@map("product_categories")
}
